<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy by design: no INTERNET permission and Android auto-backup disabled.
  The database key lives in Android Keystore and cannot be restored on another
  device, so migration happens only through the app's own encrypted backup file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Daily overdue-fee reminder (asked only when the tutor turns it on in Settings) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Privacy promise: the app never goes online. Play Billing talks to the Play Store app on the
      phone (no internet needed), but it pulls in Google's datatransport telemetry library, which
      declares INTERNET to upload diagnostics. Removing the permission keeps everything on-device.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:name=".TuitionApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuitionManager"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets other apps (WhatsApp, Gmail) read a receipt PDF only when the tutor shares it -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11+ package visibility: needed to open wa.me links and the share sheet targets -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

</manifest>
